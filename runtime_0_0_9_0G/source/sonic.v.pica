; SA3DS 0.0.9.0E minimal textured vertex shader.
; Uses the same matrix/attribute pattern as devkitPro Citro3D examples.

.fvec projection[4], modelView[4]
.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias zeros myconst.xxxx

.out outpos position
.out outtc0 texcoord0.st

.alias inpos v0
.alias intc0 v1

.entry vmain
.proc vmain
    dp4 r15.x, modelView[0], inpos
    dp4 r15.y, modelView[1], inpos
    dp4 r15.z, modelView[2], inpos
    dp4 r15.w, modelView[3], inpos
    dp4 outpos.x, projection[0], r15
    dp4 outpos.y, projection[1], r15
    dp4 outpos.z, projection[2], r15
    dp4 outpos.w, projection[3], r15

    mov outtc0.st, intc0
    mov outtc0.pq, zeros
    end
.end
